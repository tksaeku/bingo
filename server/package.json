{
  "name": "bingo-server",
  "version": "1.0.0",
  "description": "Bingo game server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "migrate:leaderboard": "tsx src/scripts/migrateLeaderboard.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^14.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
