# Port the API listens on (default 5174)
PORT=5174

# Shared secret for admin endpoints (x-admin-key header). If unset, admin endpoints return 503.
ADMIN_KEY=change-me

# Comma-separated CORS allow-list. Defaults to the Firebase Hosting origins and http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Path to a service account JSON for local development (relative to server/). Takes precedence over a
# machine-wide GOOGLE_APPLICATION_CREDENTIALS. Leave unset on App Hosting (ambient credentials are used).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Point at the Firestore emulator instead of a real project (no credentials needed)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Number of reverse-proxy hops in front of the server, used for client IP detection and rate limiting (default 1)
TRUSTED_PROXY_HOPS=1
